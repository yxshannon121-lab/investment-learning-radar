# OpenAI is optional. Free rule analysis is used by default.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ENABLE_OPENAI_ANALYSIS=false
DATABASE_URL=sqlite:///data/investment_radar.sqlite3
TIMEZONE=Europe/Helsinki

# Static dashboard is the default output: docs/index.html.

# Optional email settings. Email commands are disabled by default because normal
# commands generate a static dashboard instead of sending mail.
RESEND_API_KEY=
REPORT_EMAILS=
SENDER_EMAIL=
EMAIL_DRY_RUN=true

# Cost controls
MAX_REPORT_ITEMS=10
MIN_AI_SCORE=8
REPORT_LOOKBACK_HOURS=24
FETCH_TIMEOUT_SECONDS=20
